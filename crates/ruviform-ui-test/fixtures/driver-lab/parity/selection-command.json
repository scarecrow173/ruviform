{
  "schemaVersion": 1,
  "manifest": "rvf.driver-lab.parity/v1",
  "issue": "https://github.com/scarecrow173/ruviform/issues/448",
  "description": "行選択と command 起動の Fake/GPUI 同一 fixture。view は ViewSpec（serde 形式）、expect は両 driver が検査する semantic 期待値。Fake と GPUI は同じ操作（行の選択・Button の押下）から同じ Action intent（kind/target/controlId/action/params）と、同じ snapshot（selected・phase）を得ること、Button の a11y 木と描画ラベルが一致することを検査する。job を伴う command の receipt 進行（button.jobReceipt: ack → 終端 applied / rejected）は、runtime が返す result を両 driver の view へ同じ経路（CommandReceipt::from_result）で流して検査する。receipt の発行元は runtime であり、GPUI driver 自身は発行しない。",
  "view": {
    "root": {
      "type": "panel",
      "key": "root",
      "title": null,
      "visual": { "error": null },
      "a11y": {},
      "children": [
        {
          "type": "table",
          "key": "jobs",
          "columns": ["job", "state"],
          "rows": [
            ["job-1", "done"],
            ["job-2", "queued"],
            ["job-3", null]
          ],
          "selection": { "target": "jobs.select" },
          "visual": { "error": null },
          "a11y": { "label": "jobs" }
        },
        {
          "type": "button",
          "key": "run",
          "label": "Run",
          "target": "run.start",
          "action": "start",
          "params": { "dataset": "ds-1" },
          "visual": { "error": null },
          "a11y": {}
        }
      ]
    }
  },
  "expect": {
    "mountedKeys": ["root", "jobs", "run"],
    "table": {
      "selectRow": 1,
      "intents": [
        {
          "kind": "action",
          "target": "jobs.select",
          "controlId": "jobs",
          "action": "select",
          "params": { "row": 1 }
        }
      ],
      "selectedAfterSelect": 1,
      "phase": "pending",
      "drawnHeader": ["job", "state"]
    },
    "button": {
      "intents": [
        {
          "kind": "action",
          "target": "run.start",
          "controlId": "run",
          "action": "start",
          "params": { "dataset": "ds-1" }
        }
      ],
      "phase": "pending",
      "drawnLabel": "Run",
      "a11yTree": { "role": "button", "name": "Run" },
      "jobReceipt": { "ack": "accepted", "applied": "applied", "rejected": "rejected" }
    }
  }
}
