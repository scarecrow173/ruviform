{
  "schemaVersion": 1,
  "ruleset": "rvf.driver-boundary/v1",
  "strict": true,
  "forbiddenDepRoots": [
    "gpui",
    "gpui-*",
    "wry",
    "tao",
    "winit",
    "dpi",
    "raw-window-handle",
    "web-view",
    "webkit*",
    "gtk*",
    "gdk*",
    "glib*",
    "egui",
    "eframe",
    "iced*",
    "slint",
    "fltk*",
    "druid*",
    "vizia",
    "dioxus*",
    "azul",
    "tauri*",
    "quick-js",
    "rquickjs*",
    "deno_core",
    "javascriptcore-rs",
    "v8"
  ],
  "protectedPackages": [
    "ruviform-ui",
    "ruviform-ui-theme"
  ],
  "forbiddenPathRoots": [
    "gpui",
    "gpui_component",
    "gpui_base",
    "gpui_kit",
    "gpui_toolkit",
    "gpui_audio_kit",
    "gpui_design",
    "gpui_platform",
    "gpui_util",
    "wry",
    "tao",
    "winit",
    "dpi",
    "raw_window_handle",
    "web_view",
    "webkit2gtk",
    "gtk",
    "gtk3",
    "gtk4",
    "gdk",
    "glib",
    "egui",
    "eframe",
    "iced",
    "iced_core",
    "iced_winit",
    "slint",
    "fltk",
    "druid",
    "vizia",
    "dioxus",
    "azul",
    "tauri",
    "quick_js",
    "rquickjs",
    "deno_core",
    "javascriptcore",
    "v8"
  ],
  "allowlist": [
    {
      "package": "ruviform-ui-webview",
      "role": "driver-adapter",
      "allowedDeps": ["wry", "tao", "dpi"],
      "viaFeatures": ["webview"],
      "required": true,
      "reason": "Issue #156 で採用済みの WebView driver adapter。wry/tao 系 backend 依存は webview feature 経由の optional のみ許可"
    },
    {
      "package": "ruviform-ui-gpui",
      "role": "driver-adapter",
      "allowedDeps": ["gpui", "raw-window-handle"],
      "viaFeatures": ["gpui", "gpui-test", "real-scenario"],
      "required": true,
      "reason": "Issue #386 の GPUI 標準 Driver adapter（main merge 済み）。gpui/gpui-test feature 経由の optional のみ許可。raw-window-handle は Issue #388 NativeSurfaceSlot の OS parent handle 捕捉用途で gpui feature 経由 optional のみ。real-scenario は Issue #314 slice 4 の real-window VisualGuiTest adapter で gpui + ruviform-ui-test のみを有効化し gpui/test-support を含めない"
    },
    {
      "package": "ruviform-poc-native-dock",
      "role": "composition-root",
      "allowedDeps": [],
      "viaFeatures": [],
      "required": true,
      "reason": "Issue #388/#389 Native Dock PoC harness — adapter への依存と toolkit feature 起動自体が職務の実 binary composition root(利用側層)"
    }
  ]
}
