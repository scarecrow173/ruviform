    { "op": "attach", "windowId": "win-2" },
    { "op": "projection", "target": "mixer.ch1.fader", "revision": 2, "value": { "plain": 0.9, "normalized": 0.9 } }
  ],
  "expect": {
    "dispatched": [
      { "kind": "begin", "gestureId": "g-1" },
      { "kind": "preview", "gestureId": "g-1" },
      { "kind": "cancel", "gestureId": "g-1" }
    ],
    "diagnostics": { "staleReceipts": 1, "detachedIntents": 1 },
    "phases": ["stale", "observed"],
    "linkStats": { "attaches": 2 }
  }
}
