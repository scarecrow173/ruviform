{
  "v": 1,
  "suite": "scenario-binding",
  "id": "detach-reattach",
  "seed": null,
  "setup": {
    "consumer": "daw",
    "viewId": "view-1",
    "windowId": "win-1",
    "ackTimeoutMs": 1000,
    "targets": [
      { "control": "fader-1", "target": "mixer.ch1.fader", "initial": 0.0 }
    ]
  },
  "in": [
    { "op": "gesture", "control": "fader-1", "inputs": [
