; RvfVirtualAudio.inf — Issue #977 virtual audio endpoint driver の
; install package。Microsoft SysVAD (Windows-driver-samples, MS-PL) の
; ComponentizedAudioSample 構成を ruviform 向けに最小化した派生 INF。
;
; root-enumerated software device（hardware id ROOT\RvfVirtualAudio）に
; KMDF port-class audio driver（RvfVirtualAudio.sys）を結合し、
; render "Ruviform Cable Input" / capture "Ruviform Cable Output" の
; 仮想 audio endpoint 1 対を登録する。endpoint 名は topology bridge pin の
; custom pin-name GUID を MediaCategories で文字列に結び付けて固定する。

[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 01/01/2025,1.0.0.0
CatalogFile = RvfVirtualAudio.cat
PnpLockdown = 1

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
RvfVirtualAudio.sys = 1,,

[DestinationDirs]
RvfVirtualAudio_Device.CopyList = 13 ; DIRID_DRIVERSTORE

[Manufacturer]
; DIRID 13 (CopyFiles) は 10.0.16299 以降の構文 — TargetOSVersion
; decoration を付けて下位 OS への install を制限する（InfVerif error 1199）。
%MfgName% = RvfVA,NTamd64.10.0...16299

; x64 windows-2025 runner 専用（test-signing install 対象は amd64 のみ）。
[RvfVA.NTamd64.10.0...16299]
%RvfVirtualAudio.DeviceDesc% = RvfVirtualAudio_Device, ROOT\RvfVirtualAudio

;==========================================================================
; DDInstall — port-class audio driver は in-box ks.inf / wdmaudio.inf の
; registration を引き継ぐ（SysVAD ComponentizedAudioSample と同型）。
;==========================================================================
[RvfVirtualAudio_Device.NT]
Include   = ks.inf, wdmaudio.inf
Needs     = KS.Registration, WDMAUDIO.Registration
CopyFiles = RvfVirtualAudio_Device.CopyList
AddReg    = RvfVirtualAudio_Device.AddReg

[RvfVirtualAudio_Device.CopyList]
RvfVirtualAudio.sys

[RvfVirtualAudio_Device.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,RvfVirtualAudio.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer"

HKR,Drivers\wave\wdmaud.drv, Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv, Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv, Description,,%RvfVirtualAudio.MediaDesc%
HKR,Drivers\midi\wdmaud.drv, Description,,%RvfVirtualAudio.MidiDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%RvfVirtualAudio.MediaDesc%

HKR,PowerSettings,ConservationIdleTime,3,30,0,0,0
HKR,PowerSettings,PerformanceIdleTime,3,30,0,0,0
HKR,PowerSettings,IdlePowerState,3,3,0,0,0

; bridge pin の custom pin-name GUID → endpoint 表示名の結び付け。
; {131373ee-e400-4a68-ab5e-9ded0544f2b4} → "Ruviform Cable Input"  (render)
; {46eab9d5-1e22-45f8-a744-1cf7561dc20a} → "Ruviform Cable Output" (capture)
HKR,%MEDIA_CATEGORIES%\%RvfCableInputNameGuid%,Name,,%RvfVirtualAudio.RvfCableInputName%
HKR,%MEDIA_CATEGORIES%\%RvfCableOutputNameGuid%,Name,,%RvfVirtualAudio.RvfCableOutputName%

;==========================================================================
; Interfaces — miniport pair (topology + wave) ごとに KSNAME を登録する。
; KSNAME は minipairs.h の TopoName/WaveName と一致させる必要がある。
;==========================================================================
[RvfVirtualAudio_Device.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologySpeaker%, RvfVirtualAudio.I.TopologySpeaker
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, RvfVirtualAudio.I.TopologySpeaker
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveSpeaker%,     RvfVirtualAudio.I.WaveSpeaker
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveSpeaker%,     RvfVirtualAudio.I.WaveSpeaker
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%,     RvfVirtualAudio.I.WaveSpeaker
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyMicIn%,   RvfVirtualAudio.I.TopologyMicIn
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMicIn%,   RvfVirtualAudio.I.TopologyMicIn
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveMicIn%,       RvfVirtualAudio.I.WaveMicIn
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveMicIn%,       RvfVirtualAudio.I.WaveMicIn
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveMicIn%,       RvfVirtualAudio.I.WaveMicIn

; render topology filter
[RvfVirtualAudio.I.TopologySpeaker]
AddReg = RvfVirtualAudio.I.TopologySpeaker.AddReg

[RvfVirtualAudio.I.TopologySpeaker.AddReg]
HKR,,FriendlyName,,%RvfVirtualAudio.TopologySpeaker.szPname%
HKR,,CLSID,,%Proxy.CLSID%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

; render wave filter
[RvfVirtualAudio.I.WaveSpeaker]
AddReg = RvfVirtualAudio.I.WaveSpeaker.AddReg

[RvfVirtualAudio.I.WaveSpeaker.AddReg]
HKR,,FriendlyName,,%RvfVirtualAudio.WaveSpeaker.szPname%
HKR,,CLSID,,%Proxy.CLSID%

; capture topology filter
[RvfVirtualAudio.I.TopologyMicIn]
AddReg = RvfVirtualAudio.I.TopologyMicIn.AddReg

[RvfVirtualAudio.I.TopologyMicIn.AddReg]
HKR,,FriendlyName,,%RvfVirtualAudio.TopologyMicIn.szPname%
HKR,,CLSID,,%Proxy.CLSID%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

; capture wave filter
[RvfVirtualAudio.I.WaveMicIn]
AddReg = RvfVirtualAudio.I.WaveMicIn.AddReg

[RvfVirtualAudio.I.WaveMicIn.AddReg]
HKR,,FriendlyName,,%RvfVirtualAudio.WaveMicIn.szPname%
HKR,,CLSID,,%Proxy.CLSID%

;==========================================================================
; Services — KMDF port-class driver。KMDF runtime は in-box のため
; coinstaller は不要。KmdfLibraryVersion は vcxproj の KmdfVersionNumber
; と一致させる（両者 1.33 で固定）。
;==========================================================================
[RvfVirtualAudio_Device.NT.Services]
AddService = RvfVirtualAudio,0x00000002,RvfVirtualAudio_Service_Inst ; SPSVCINST_ASSOCSERVICE

[RvfVirtualAudio_Service_Inst]
DisplayName   = %RvfVirtualAudio.SvcDesc%
ServiceType   = 1 ; SERVICE_KERNEL_DRIVER
StartType     = 3 ; SERVICE_DEMAND_START
ErrorControl  = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\RvfVirtualAudio.sys

[RvfVirtualAudio_Device.NT.Wdf]
KmdfService = RvfVirtualAudio, RvfVirtualAudio_WdfSection

[RvfVirtualAudio_WdfSection]
KmdfLibraryVersion = 1.33

;==========================================================================
; HW — port-class audio device 必須の DeviceType と audio 用 SDDL
; （SysVAD ComponentizedAudioSample と同一の設定値）。
;==========================================================================
[RvfVirtualAudio_Device.NT.HW]
AddReg = RvfVirtualAudio_Device.HW.AddReg

[RvfVirtualAudio_Device.HW.AddReg]
HKR,,DeviceType,0x00010001,0x0000001D     ; FILE_DEVICE_SOUND
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[Strings]
ProviderName              = "Ruviform"
MfgName                   = "Ruviform"
DiskName                  = "RvfVirtualAudio Installation Disk"
; KSNAME — minipairs.h の L"..." endpoint 名と一致必須
KSNAME_TopologySpeaker    = "TopologySpeaker"
KSNAME_WaveSpeaker        = "WaveSpeaker"
KSNAME_TopologyMicIn      = "TopologyMicIn"
KSNAME_WaveMicIn          = "WaveMicIn"
KSCATEGORY_AUDIO          = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER         = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE        = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_TOPOLOGY       = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSCATEGORY_REALTIME       = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSNODETYPE_ANY            = "{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
Proxy.CLSID               = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
MEDIA_CATEGORIES          = "MediaCategories"
RvfCableInputNameGuid     = "{131373EE-E400-4A68-AB5E-9DED0544F2B4}"
RvfCableOutputNameGuid    = "{46EAB9D5-1E22-45F8-A744-1CF7561DC20A}"
RvfVirtualAudio.DeviceDesc            = "Ruviform Virtual Audio Device"
RvfVirtualAudio.MediaDesc             = "Ruviform Virtual Audio Device"
RvfVirtualAudio.MidiDesc              = "Ruviform Virtual Audio Device (MIDI)"
RvfVirtualAudio.SvcDesc               = "Ruviform Virtual Audio Driver"
RvfVirtualAudio.RvfCableInputName     = "Ruviform Cable Input"
RvfVirtualAudio.RvfCableOutputName    = "Ruviform Cable Output"
RvfVirtualAudio.TopologySpeaker.szPname = "RvfVirtualAudio Topology Speaker"
RvfVirtualAudio.WaveSpeaker.szPname     = "RvfVirtualAudio Wave Speaker"
RvfVirtualAudio.TopologyMicIn.szPname   = "RvfVirtualAudio Topology Mic In"
RvfVirtualAudio.WaveMicIn.szPname       = "RvfVirtualAudio Wave Mic In"
